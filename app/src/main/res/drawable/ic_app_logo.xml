<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- Fond Squircle Noir Ardoise & Caviar de Prestige -->
    <path
        android:pathData="M 128,16 L 384,16 C 448,16 496,64 496,128 L 496,384 C 496,448 448,496 384,496 L 128,496 C 64,496 16,448 16,384 L 16,128 C 16,64 64,16 128,16 Z"
